# ==============================================================================
# Repository Root Git Ignore — Hospital Mobility Project
# ==============================================================================

# Dependencies (applies across root, backend/, frontend/, etc.)
node_modules/
**/node_modules/
.pnp
.pnp.js

# Environment variables & secrets (preserve .env.example)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Build outputs & distribution bundles
dist/
**/dist/
build/
**/build/
out/
.next/

# Logs & debug outputs
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Test coverage & tooling caches
coverage/
**/coverage/
.nyc_output/
*.lcov

# Temporary files & compiler caches
tmp/
temp/
**/tmp/
**/temp/
.cache/
**/.cache/
.eslintcache
.stylelintcache
*.tsbuildinfo

# Local database directories
data/
db/
mongo-data/
**/data/
**/db/
**/mongo-data/

# OS metadata & thumbnail files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor temporary files
.idea/
*.swp
*.swo
*~
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
