# Hospital Mobility Project Backend Environment Config
PORT=5000
NODE_ENV=development

# MongoDB Connection String:
# For local MongoDB: mongodb://127.0.0.1:27017/hospital_mobility
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/hospital_mobility?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/hospital_mobility

# Simulation Parameters
FALL_ACCEL_THRESHOLD=2.8
INACTIVITY_TIMEOUT_SEC=30
AUTO_SIMULATION_ENABLED=false
AUTO_SIMULATION_INTERVAL_MS=3000

# Client URL for CORS
CLIENT_URL=http://localhost:5173
