# Hospital Mobility Project Backend Environment Config
PORT=5000
NODE_ENV=development

# MongoDB Connection String:
# For local MongoDB: mongodb://127.0.0.1:27017/hospital_mobility
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/hospital_mobility?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/hospital_mobility

# Optional: Dedicated Test Database URI (defaults to <MONGODB_URI>_test in test mode)
# TEST_MONGODB_URI=mongodb://127.0.0.1:27017/hospital_mobility_test


# Simulation Parameters
FALL_ACCEL_THRESHOLD=2.8
INACTIVITY_TIMEOUT_SEC=30
AUTO_SIMULATION_ENABLED=false
AUTO_SIMULATION_INTERVAL_MS=3000

# Client URL for CORS
CLIENT_URL=http://localhost:5173

# USB Serial Hardware Integration (Arduino Piezoelectric Assembly)
SERIAL_ENABLED=false
SERIAL_PORT=COM5
SERIAL_BAUD_RATE=9600
SERIAL_DEVICE_CODE=ARDUINO-PIEZO-01
SERIAL_RECONNECT_INTERVAL_MS=5000

# Laptop Serial-to-Cloud IoT Gateway Authentication
# Strong server-to-server shared secret (must match on Render backend and local laptop gateway)
GATEWAY_SECRET=change-this-to-a-secure-random-token-min-32-chars
